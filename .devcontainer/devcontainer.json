{
  "name": "Python Data Science",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash"
  },
  "postCreateCommand": "pip install -r requirements.txt || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "eamodio.gitlens"
      ]
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh,type=bind,consistency=cached,readonly"
  ],
  // "forwardPorts": [
  // 8501
  // ], // Streamlit/Flask port
  // "postCreateCommand": "chown -R vscode:vscode /home/vscode",
  // "postCreateCommand": "git config --global user.name 'Mathieu McKinnon' && git config --global user.email 'mathieu.mckinnon@gmail.com'",
  // "postCreateCommand": "pip install -r requirements.txt",
  "remoteUser": "dev"
}