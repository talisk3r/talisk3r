{
  "name": "Python Data Science",
  "dockerFile": "Dockerfile",
  "context": "..", // ← Critical! Points to project root (where requirements.txt lives)
  "workspaceFolder": "/workspace", // Matches WORKDIR in Dockerfile
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash"
  },
  "extensions": [
    "ms-python.python"
  ],
  "forwardPorts": [
    8501
  ], // Streamlit/Flask port
  // "postCreateCommand": "chown -R vscode:vscode /home/vscode",
  // "postCreateCommand": "git config --global user.name 'Mathieu McKinnon' && git config --global user.email 'mathieu.mckinnon@gmail.com'",
  "postCreateCommand": "pip install -r requirements.txt"
}